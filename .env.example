# ─── RESCO eCard environment variables ─────────────────────────────────────
# Copy to .env for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# Prisma database URL.
#  • Local dev:  DATABASE_URL="file:/home/z/my-project/db/custom.db"
#  • Production (Vercel) with Turso: DATABASE_URL="libsql://<your-db>.tur.so"
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Turso auth token — ONLY required when DATABASE_URL is a libsql:// URL (production).
# Leave blank for local file-based SQLite.
DATABASE_AUTH_TOKEN=""

# Session signing secret. Generate a strong random string for production.
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="resco-ecard-dev-secret-change-in-prod"

# Principal password used by the seed script. Defaults to "affordables" if unset.
# Override ONLY if you want a different password at seed time. The seed upserts
# the principal, so re-running it resets the password to this value.
PRINCIPAL_PASSWORD=""

# Set to "1" to also seed demo teachers + test student (Mr. Ade, Mrs. Adebayo,
# John Doe). Leave unset/blank for a clean production seed (principal + the
# curriculum library only).
SEED_DEMO=""
